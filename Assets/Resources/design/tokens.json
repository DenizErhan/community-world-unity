{
  "meta": {
    "name": "Community World Design System",
    "version": "0.1.0",
    "style": "Flat-color vector, 2.5D isometric, single camera angle, no outlines, limited palette per age.",
    "rules": [
      "One camera angle: 2:1 isometric (tile 128x64). Never rotate the world.",
      "Flat fills only. Depth comes from three face shades (top / left / right) derived from one base color.",
      "No outlines on world objects. The only strokes are interaction highlights (hover, selection).",
      "Every age has its own palette and building silhouette; palette AND shape change together.",
      "Colors are used by role (wall, roof, water ...), never as raw hex in code.",
      "All art is generated from this file by tools/gen_assets.py. Do not hand-edit generated SVGs."
    ]
  },

  "grid": {
    "tile_w": 128,
    "tile_h": 64,
    "slab_depth": 26,
    "tile_bleed": 1.5,
    "tile_canvas": [132, 68],
    "tile_anchor": [66, 34],
    "sprite_canvas": [128, 128],
    "sprite_anchor": [64, 88],
    "raster_scale": 3
  },

  "light": {
    "note": "Light comes from the upper left: left face is slightly shaded, right face is darkest, top face is lightest.",
    "left_face_darken": 0.12,
    "right_face_darken": 0.28,
    "top_face_lighten": 0.10,
    "roof_left_darken": 0.10,
    "roof_right_darken": 0.30,
    "contact_shadow_opacity": 0.14
  },

  "ages": {
    "stone": {
      "label": "Stone Age",
      "palette": {
        "ground_a": "#a5cf86", "ground_b": "#98c47a", "ground_decor": "#7fae63",
        "slab_left": "#8a6b4a", "slab_right": "#6f553a",
        "wall": "#bdb3a2", "roof": "#8b5e3c", "door": "#5a4632", "window": "#3f3a33",
        "crop": "#d8b94f", "water": "#3b8fd0", "rock": "#8a8f9c", "wood": "#9a7448"
      }
    },
    "iron": {
      "label": "Iron Age",
      "palette": {
        "ground_a": "#9fc27f", "ground_b": "#92b874", "ground_decor": "#78a35e",
        "slab_left": "#7d6247", "slab_right": "#634c37",
        "wall": "#b58f66", "roof": "#6b4a38", "door": "#3d3d46", "window": "#2f2f38",
        "crop": "#cfa63e", "water": "#3584c4", "rock": "#7d828f", "wood": "#8c6a45"
      }
    },
    "medieval": {
      "label": "Middle Ages",
      "palette": {
        "ground_a": "#9bbf7c", "ground_b": "#8fb571", "ground_decor": "#759f5b",
        "slab_left": "#6f5a4a", "slab_right": "#584638",
        "wall": "#c4704f", "roof": "#5b6574", "door": "#3a4252", "window": "#2d3442",
        "crop": "#c99a35", "water": "#2f7bb8", "rock": "#9097a3", "wood": "#7f6244"
      }
    }
  },

  "shapes": {
    "hut": {
      "role_wall": "wall", "role_roof": "roof", "shadow": 0.8,
      "ages": {
        "stone":    { "f": 0.62, "h": 34, "roof_h": 28, "overhang": 0.74, "door": false, "window": false, "chimney": false },
        "iron":     { "f": 0.66, "h": 32, "roof_h": 30, "overhang": 0.78, "door": true,  "window": false, "chimney": true },
        "medieval": { "f": 0.68, "h": 44, "roof_h": 34, "overhang": 0.80, "door": true,  "window": true,  "chimney": true }
      }
    },
    "farm": {
      "role_base": "crop", "shadow": 0.0,
      "f": 0.9, "h": 10, "stripes": 4, "stripe_darken": 0.30
    },
    "well": {
      "role_base": "rock", "role_water": "water", "shadow": 0.75,
      "f": 0.6, "h": 22, "water_inset": 0.42
    },
    "quarry": {
      "role_base": "rock", "shadow": 0.85,
      "boulders": [
        { "dx": 0,   "dy": -8, "f": 0.42, "h": 26, "darken": 0.05, "lighten": 0.0 },
        { "dx": -22, "dy": 6,  "f": 0.38, "h": 16, "darken": 0.0,  "lighten": 0.0 },
        { "dx": 22,  "dy": 8,  "f": 0.34, "h": 12, "darken": 0.0,  "lighten": 0.08 }
      ]
    }
  },

  "ground": {
    "variants": {
      "a": { "tufts": [[-30, 2], [18, -8], [8, 10]], "pebbles": [] },
      "b": { "tufts": [[-14, -6], [34, 4], [-4, 12]], "pebbles": [[22, -12], [-36, 6]] }
    }
  },

  "ui": {
    "colors": {
      "panel_top": "#1a1f29d9",
      "panel_bottom": "#1a1f29eb",
      "text": "#e9edf2",
      "text_dim": "#8d96a5",
      "text_warn": "#f0a5a0",
      "button_normal": "#2b3240",
      "button_hover": "#353d4e",
      "button_pressed": "#357048",
      "button_disabled": "#1c212b",
      "button_unaffordable_tint": "#ffb8b8",
      "button_confirm": "#2b7347",
      "button_cancel": "#8f3a3a",
      "resource_food": "#8fd16a",
      "resource_water": "#6bb8f0",
      "resource_stone": "#c4c7d0"
    },
    "world": {
      "clear": "#cfe6d4",
      "hover_ok": "#66ff80f2",
      "hover_bad": "#ff594df2",
      "hover_neutral": "#ffffffe6",
      "hover_dim": "#ffffff59",
      "ghost_alpha": 0.55,
      "highlight_width": 5
    },
    "font_size": { "label": 24, "button": 22, "small": 20 },
    "spacing": { "panel_margin": 12, "gap": 8 },
    "button": { "radius": 12, "min_height": 104 },
    "icon": { "canvas": 96, "stroke": 12, "display": 56, "disabled_alpha": 0.35, "color_role": "text" },
    "placement": {
      "note": "Placing or moving a building: a ghost on the grid, confirm with the tick, cancel with the cross, nudge with the four diagonal arrows (they point the way the next tile lies) or drag the ghost.",
      "grab_px": 110,
      "pick_height": 70,
      "pick_min_px": 44,
      "drag_slop": 6,
      "confirm_stretch": 1.4,
      "view_margin": 90
    },
    "badge": {
      "note": "Collect badge floating over a building that holds output; constant size on screen.",
      "radius": 26,
      "lift": 100,
      "ring": 4,
      "font": 22,
      "level_font": 18
    },
    "actionbar": {
      "note": "Tapping a building selects it and shows these four actions under it: info, move, upgrade, remove. Remove needs a second tap.",
      "button": 84,
      "gap": 6,
      "margin": 6,
      "offset": 10,
      "arm_seconds": 3
    },
    "type_note": "Engine default font for now. Before adding more languages, pick one OFL font family that covers every shipped script."
  },

  "motion": {
    "toast_hold": 2.2,
    "toast_fade": 0.6,
    "note": "Light, looping, never blocking. Drawn by fx.gd above the world; positions are world units from the tile centre; sizes grow on screen when zoomed out (min_screen_scale). Off when the OS asks for reduced motion.",
    "enabled": true,
    "fps": 30,
    "min_screen_scale": 0.7,
    "view_margin": 160,
    "colors": {
      "smoke": "#f4f1ea",
      "glint": "#ffffff",
      "dust": "#e8dcc2",
      "sparkle": "#ffe08a",
      "butterfly": ["#f2a65a", "#f7e07a", "#e87aa6"]
    },
    "loops": {
      "hut": [
        { "type": "smoke", "anchor": { "stone": [0, -62], "iron": [-14, -57], "medieval": [-14, -69] },
          "puffs": 3, "period": 3.6, "rise": 36, "drift": 14, "r0": 4, "r1": 11, "alpha": 0.75 }
      ],
      "farm": [
        { "type": "sway", "grid": 3, "span": 0.55, "top": -10, "height": [10, 15], "amp": 3.2, "speed": 1.7, "wave": 0.9 }
      ],
      "well": [
        { "type": "shimmer", "center": [0, -22], "half": [27, 13], "glints": 3, "period": 2.6, "ripple_period": 4.4 }
      ],
      "quarry": [
        { "type": "dust", "anchor": [-4, 8], "spread": 18, "puffs": 2, "period": 4.8, "r0": 4, "r1": 14, "alpha": 0.65 }
      ]
    },
    "ambient": {
      "butterflies": { "count": 3, "area": 0.7, "speed": 0.32, "size": 16 }
    },
    "events": {
      "place": { "dur": 0.6, "puffs": 8, "radius": [40, 20] },
      "upgrade": { "dur": 1.1, "stars": 9, "rise": 56, "size": 9 },
      "collect": { "dur": 1.0, "rise": 46, "font": 22 }
    }
  }
}
